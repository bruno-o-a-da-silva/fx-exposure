<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>FX exposure, {{ today }}</title>
<style>
  body { background: #111111; color: #EDEAE2; font: 14px/1.5 Inter, "DejaVu Sans", sans-serif;
         margin: 40px auto; max-width: 1100px; padding: 0 24px; }
  h1 { font-family: "Playfair Display", "DejaVu Serif", serif; font-weight: 400; font-size: 40px;
       margin: 0; }
  h2 { font-family: "Playfair Display", "DejaVu Serif", serif; font-weight: 400; color: #D4AF37; }
  .muted { color: #8A8A8A; }
  .big { font-family: "Playfair Display", "DejaVu Serif", serif; font-size: 32px; color: #D4AF37; }
  .cards { display: flex; gap: 40px; margin: 24px 0; }
  table { border-collapse: collapse; width: 100%; }
  th, td { padding: 4px 8px; text-align: right; border-bottom: 1px solid #2A2A2A; }
  th:first-child, td:first-child { text-align: left; }
  th { color: #8A8A8A; font-weight: 400; }
  tr.flag td { color: #D4AF37; }
  td.neg { color: #E08A6E; }
</style>
</head>
<body>
<h1>FX exposure on open orders</h1>
<p class="muted">{{ source }}. Spot {{ spot }} BRL/USD, annual volatility {{ vol_pct }}%, read on
{{ today }}. {{ note }}</p>
<div class="cards">
  <div><div class="big">{{ fmt(now) }}</div><div class="muted">margin at spot (BRL)</div></div>
  <div><div class="big">{{ fmt(risk) }}</div><div class="muted">margin at risk, 95% band (BRL)</div></div>
  <div><div class="big">{{ flagged }} of {{ rows|length }}</div><div class="muted">orders that lose money inside the band</div></div>
</div>

<h2>Book under each shock</h2>
<table>
<tr><th>Dollar move</th>{% for s in shocks %}<th>{{ "%+d"|format(s) }}%</th>{% endfor %}</tr>
<tr><td>Total margin (BRL)</td>{% for m in by_shock %}<td class="{{ 'neg' if m < 0 }}">{{ fmt(m) }}</td>{% endfor %}</tr>
</table>

<h2>Margin at risk per order</h2>
<svg width="100%" viewBox="0 0 1000 {{ 22 * rows|length + 10 }}" role="img"
     aria-label="Margin at risk per order, largest first">
{% for r in rows %}
  <text x="0" y="{{ 22 * loop.index0 + 15 }}" fill="#8A8A8A" font-size="12">{{ r.po.po }}</text>
  <rect x="80" y="{{ 22 * loop.index0 + 4 }}" height="14"
        width="{{ (700 * r.at_risk / top)|round(1) }}" fill="{{ '#D4AF37' if r.flagged else '#8C7526' }}"/>
  <text x="{{ 90 + (700 * r.at_risk / top)|round(1) }}" y="{{ 22 * loop.index0 + 15 }}"
        fill="#EDEAE2" font-size="12">{{ fmt(r.at_risk) }}</text>
{% endfor %}
</svg>

<table>
<tr><th>Order</th><th>SKU</th><th>Due</th><th>Costed at</th><th>Break-even</th><th>95% rate</th>
<th>Cost per unit at spot</th><th>Margin at spot</th><th>Per 1% move</th><th>At risk</th><th>Margin at 95% rate</th></tr>
{% for r in rows %}
<tr class="{{ 'flag' if r.flagged }}"><td>{{ r.po.po }}</td><td>{{ r.po.sku }}</td><td>{{ r.po.due }}</td>
<td>{{ r.po.costing_rate }}</td><td>{{ r.po.breakeven }}</td><td>{{ r.high }}</td>
<td>{{ fmt(r.po.cost_per_unit(spot)) }}</td><td>{{ fmt(r.margin_now) }}</td><td>{{ fmt(r.per_pct) }}</td>
<td>{{ fmt(r.at_risk) }}</td><td class="{{ 'neg' if r.margin_high < 0 }}">{{ fmt(r.margin_high) }}</td></tr>
{% endfor %}
</table>
<p class="muted">Gold rows lose money if the dollar reaches the 95% rate before payment. The
band is a model with an assumed volatility, not a forecast.</p>
</body>
</html>
